{{- /* Debian / Ubuntu: official repositories, then the packages in .chezmoidata/packages.yaml.
       Re-runs when those lists, the profile or the host change. */ -}}
{{- if eq (includeTemplate "package-manager" . | trim) "apt" -}}
{{- $apt := includeTemplate "package-list" (dict "manager" "apt" "data" .) -}}
{{- $repos := concat .repos.apt (dig .host "repos" "apt" (list) .hosts) -}}
#!/bin/sh
# apt {{ dict "repos" $repos "packages" $apt | toJson | sha256sum }}
set -eu

{{ template "as-root" }}

# codename: print the release codename, the Ubuntu one on derivatives.
codename() {
  (. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
}

# missing PACKAGE...: print the packages dpkg has not installed.
missing() {
  for pkg in "$@"; do
    dpkg-query -W -f '${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || echo "$pkg"
  done
}

# add_repo NAME KEY_URL REPO_URL SUITE COMPONENTS: add an apt repository as sources.list.d/NAME.list.
# Left alone when another file configures the URL (a package, extrepo, by hand); our own file is
# rewritten when it or its key is out of date, which repairs a broken earlier run.
# SUITE `codename` means this release's codename. apt reads binary keys only as .gpg and armored
# keys only as .asc, so a key URL ending in .gpg is saved as .gpg and any other (.pub, .asc, none) as .asc.
add_repo() {
  case "$2" in
    *.gpg) keyring="/etc/apt/keyrings/$1.gpg" ;;
    *) keyring="/etc/apt/keyrings/$1.asc" ;;
  esac
  suite="$4"
  [ "$suite" = codename ] && suite="$(codename)"
  list="/etc/apt/sources.list.d/$1.list"
  line="deb [arch=$(dpkg --print-architecture) signed-by=$keyring] $3 $suite $5"

  grep -rqsF --exclude="$1.list" "$3" /etc/apt/sources.list /etc/apt/sources.list.d && return 0
  [ -s "$keyring" ] && [ "$(cat "$list" 2>/dev/null)" = "$line" ] && return 0

  key_tmp="$(mktemp)"
  curl -fsSL "$2" -o "$key_tmp"
  as_root install -dm 755 /etc/apt/keyrings
  for old in /etc/apt/keyrings/"$1".*; do
    [ "$old" = "$keyring" ] || as_root rm -f "$old"
  done
  as_root install -m 644 "$key_tmp" "$keyring"
  rm -f "$key_tmp"
  echo "$line" | as_root tee "$list" >/dev/null
  repo_added=1
}

# Needs root only when a repo or package is missing; upgrades are left to the OS.
main() {
  repo_added=
{{- range $repos }}
  add_repo {{ .name }} {{ .key }} {{ .url }} {{ .suite }} {{ .components }}
{{- end }}

  # shellcheck disable=SC2046
  set -- $(missing {{ $apt }})
  [ -n "$repo_added" ] || [ "$#" -gt 0 ] || return 0

  as_root apt-get update -qq
  [ "$#" -eq 0 ] || as_root apt-get install -y "$@"
}

main "$@"
{{- end }}
