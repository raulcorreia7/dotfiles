{{- /* Debian / Ubuntu: official repositories, then the packages in .chezmoidata/packages.yaml.
       Re-runs when those lists, the profile or the host change. */ -}}
{{- if eq (includeTemplate "package-manager" . | trim) "apt" -}}
{{- $apt := includeTemplate "package-list" (dict "manager" "apt" "data" .) -}}
#!/bin/sh
# apt {{ dict "repos" .repos.apt "packages" $apt | toJson | sha256sum }}
set -eu

{{ template "as-root" }}

# codename: print the release codename, the Ubuntu one on derivatives.
codename() {
  (. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
}

# missing PACKAGE...: print the packages dpkg has not installed.
missing() {
  for pkg in "$@"; do
    dpkg-query -W -f '${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || echo "$pkg"
  done
}

# add_repo NAME KEY_URL REPO_URL SUITE COMPONENTS: add an apt repository unless it is configured.
# SUITE `codename` means this release's codename. A key URL without an extension is saved as .asc.
add_repo() {
  key_file="${2##*/}"
  case "$key_file" in
    *.*) keyring="/etc/apt/keyrings/$1.${key_file##*.}" ;;
    *) keyring="/etc/apt/keyrings/$1.asc" ;;
  esac
  suite="$4"
  [ "$suite" = codename ] && suite="$(codename)"

  grep -rqsF "$3" /etc/apt/sources.list /etc/apt/sources.list.d && return 0

  as_root install -dm 755 /etc/apt/keyrings
  curl -fsSL "$2" | as_root tee "$keyring" >/dev/null
  echo "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] $3 $suite $5" |
    as_root tee "/etc/apt/sources.list.d/$1.list" >/dev/null
  repo_added=1
}

# Needs root only when a repo or package is missing; upgrades are left to the OS.
main() {
  repo_added=
{{- range .repos.apt }}
  add_repo {{ .name }} {{ .key }} {{ .url }} {{ .suite }} {{ .components }}
{{- end }}

  # shellcheck disable=SC2046
  set -- $(missing {{ $apt }})
  [ -n "$repo_added" ] || [ "$#" -gt 0 ] || return 0

  as_root apt-get update -qq
  [ "$#" -eq 0 ] || as_root apt-get install -y "$@"
}

main "$@"
{{- end }}
