# Shared git defaults. Identity comes from the answers given to `chezmoi init`, kept on the
# machine and not in the repo. ~/.gitconfig is read after this file and wins on conflict.
# Under ~/projects/personal/ the identity in ~/.config/git/personal wins; that file stays on the machine.
{{ if .gitEmail -}}
[user]
    name = {{ .gitName | quote }}
    email = {{ .gitEmail | quote }}

{{ end -}}
# GitHub logins come from gh: the active account signs every push. Switch with `ghw` / `ghp`.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

[includeIf "gitdir:~/projects/personal/"]
    path = ~/.config/git/personal

[init]
    defaultBranch = main

[pull]
    rebase = true

[fetch]
    prune = true

[merge]
    conflictstyle = zdiff3

[core]
    editor = nvim
{{- if lookPath "delta" }}
    pager = delta

# delta pages diffs and filters `git add -p`. It is set only once installed, so a missing
# delta can never break git. gitui draws its own diffs.
[interactive]
    diffFilter = delta --color-only

[delta]
    side-by-side = true
    line-numbers = true
    navigate = true
{{- end }}

# difftastic, from mise or the OS: `git dft`, `git dshow`, `git dlog`, `git dst`.
[alias]
    dft = -c diff.external=difft diff
    dshow = -c diff.external=difft show --ext-diff
    dlog = -c diff.external=difft log -p --ext-diff
    dst = -c diff.external=difft stash show --ext-diff -p
