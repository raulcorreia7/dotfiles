{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "mcp": {},
  "provider": {
    "local-inference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local inference",
      "options": {
        "baseURL": "https://ai.lab.raulcorreia.dev/v1",
        "apiKey": "{env:AI_API_KEY}"
      },
      "models": {
        "glm-5.3-flash-maya": {
          "name": "GLM 5.3 Flash (maya)"
        },
        "qwen3.8-27b-infernix": {
          "name": "Qwen3.8 27B (infernix)"
        },
        "qwen3.8-27b-ninfer": {
          "name": "Qwen3.8 27B (ninfer)"
        },
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash Next (basalt)"
        },
        "qwen3.8-flash-next-abliterated": {
          "name": "Qwen3.8 Flash Next (basalt)"
        }
      }
    }
  }
}
