{{- $manager := includeTemplate "package-manager" . | trim -}}
# Runtimes, plus tools the OS package manager has no package for.
# Everything else is a native package: see .chezmoidata/packages.yaml.
[tools]
# runtimes
bun = "latest"
deno = "latest"
go = "latest"
node = "lts"
pnpm = "latest"
python = "latest"
rust = "latest"
uv = "latest"
zig = "latest"

# tools
dprint = "latest"
"github:can1357/oh-my-pi" = { version = "latest", minimum_release_age = "0s" }
{{- range dig $manager (list) .packages.mise }}
{{ . }} = "latest"
{{- end }}
"aqua:redhat-et/ripwire" = "0.6.9"
"aqua:boyter/scc" = "latest"
"aqua:microsoft/tgrep" = "latest"
"http:rizin" = { version = "0.9.1", url = "https://github.com/rizinorg/rizin/releases/download/v{{ "{{version}}" }}/rizin-v{{ "{{version}}" }}-static-x86_64.tar.xz" } # pinned: the URL is built from the version
