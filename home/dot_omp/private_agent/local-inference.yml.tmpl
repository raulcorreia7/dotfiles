# Servers for the omp local-inference extension (github.com/raulcorreia7/omp-extensions, installed
# by .chezmoiscripts/run_after_50-omp-extensions.sh), tried in order at startup; the first that
# answers is used. Same file on every machine: a machine serving locally answers on loopback, every
# other machine reaches the keyed endpoint (aiUrl, asked on `chezmoi init`). The key comes from
# AI_API_KEY, read from ~/.config/homelab/ai.key by ~/.config/shell/init.sh and ~/.local/bin/omp.
servers:
  - http://127.0.0.1:9000
  - url: {{ get . "aiUrl" }}
    apiKeyEnv: AI_API_KEY
