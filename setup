#!/bin/sh
# dotfiles — the one entry script: set up a machine (packages → files → rc).
#
# Usage:
#   setup [-n|--dry-run] [-p|--profile <name>] [--packages|--files] [--force] [-h|--help]
#   setup diff [-p|--profile <name>]       show where this machine differs from the repo
#   setup save [-n] [-p|--profile <name>]  copy local edits back into the repo, then commit
#   setup uninstall [-n|--dry-run] [-h]
#   setup configure [-n|--dry-run] [-h]
#
# Stages (a plain run does all of them, in order):
#   --packages   install packages/base-<os> + packages/<profile>-<os>
#   --files      copy dotconfigs/ into $HOME and bin scripts into ~/.local/bin,
#                then write the shell rc block (--links is an old name for it)
#
# Files are copies, not symlinks, so each machine can differ. A copy nobody edited is updated
# when the repo has a newer version. A file edited locally is kept and reported; --force backs
# it up (path.bak) and replaces it with the repo's copy.
#
# Side effects: package installs (pacman/paru · brew bundle · apt-get), copied files
# under $HOME, backups (path.bak), and a marker block in ~/.zshrc / ~/.bashrc.
# Never deletes unowned files. --dry-run prints every planned change and writes nothing.

set -eu

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PACKAGES_DIR="$REPO_DIR/packages"
BIN_DIR="$REPO_DIR/bin"
DOTCONFIGS_DIR="$REPO_DIR/dotconfigs"
BIN_TARGET="$HOME/.local/bin"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
PROJECTS_DIR="$HOME/projects"

DEFAULT_PROFILE=personal
ALACRITTY_THEMES_REPO=https://github.com/alacritty/alacritty-theme
PARU_AUR_URL=https://aur.archlinux.org/paru.git
CACHYOS_ZSH_LINE='source /usr/share/cachyos-zsh-config/cachyos-config.zsh'
APP_DIRS="$XDG_DATA_HOME/applications:/usr/local/share/applications:/usr/share/applications"

DRY_RUN=0
FORCE=0
STAGE=all       # all | packages | files
COMMAND=setup   # setup | diff | save | uninstall | configure
PROFILE=""
OS=""
TAB=$(printf '\t')

if [ "$(id -u)" = "0" ]; then SUDO=""; else SUDO="sudo"; fi

# --- output -----------------------------------------------------------------

note() { printf '[setup] %s\n' "$*" >&2; }
warn() { printf '[setup] warning: %s\n' "$*" >&2; }
die() {
  printf '[setup] error: %s\n' "$*" >&2
  exit 1
}

usage() {
  sed -n '/^#!/,/^$/p' "$0" | sed '1d;$d'
}

# run CMD... — execute unless --dry-run, where the command is printed instead.
run() {
  if [ "$DRY_RUN" = 1 ]; then
    note "would run: $*"
    return 0
  fi
  "$@"
}

run_sudo() {
  if [ -n "$SUDO" ]; then
    run "$SUDO" "$@"
  else
    run "$@"
  fi
}

# --- small helpers ----------------------------------------------------------

count_lines() {
  awk 'NF { c++ } END { print c+0 }'
}

read_list() {
  [ -f "$1" ] || return 0
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' "$1"
}

# collect the package names for one OS token from base + profile lists
collect_packages() {
  os_key=$1
  {
    read_list "$PACKAGES_DIR/base-$os_key"
    read_list "$PACKAGES_DIR/$PROFILE-$os_key"
  }
}

# next free backup path: path.bak, then path.bak.1, path.bak.2, …
next_backup_path() {
  backup="$1.bak"
  index=0
  while [ -e "$backup" ] || [ -L "$backup" ]; do
    index=$((index + 1))
    backup="$1.bak.$index"
  done
  printf '%s\n' "$backup"
}

back_up() {
  backup=$(next_backup_path "$1")
  warn "conflict: $1 exists → backed up to $backup"
  run mv "$1" "$backup"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "${2:-$1 is required}"
}

ensure_line_in_file() {
  file=$1
  line=$2
  [ -f "$file" ] || return 0
  grep -Fqx "$line" "$file" && return 0
  run sh -c 'printf "\n%s\n" "$1" >>"$2"' sh "$line" "$file"
}

detect_os() {
  case "$(uname -s)" in
  Darwin) printf 'macos\n' ;;
  Linux)
    if [ -f /etc/arch-release ] || [ -f /etc/cachyos-release ]; then
      printf 'arch\n'
    elif [ -r /etc/os-release ]; then
      os_id=$(uname -s)
      # shellcheck disable=SC1091
      os_id=$(. /etc/os-release && printf '%s' "${ID_LIKE:-${ID:-$os_id}}")
      case "$os_id" in
      *arch*) printf 'arch\n' ;;
      *debian* | *ubuntu*) printf 'apt\n' ;;
      *) printf 'linux\n' ;;
      esac
    else
      printf 'linux\n'
    fi
    ;;
  *) printf 'unknown\n' ;;
  esac
}

# --- profiles ---------------------------------------------------------------

list_profiles() {
  {
    for file in "$PACKAGES_DIR"/*-*; do
      [ -f "$file" ] || continue
      name=${file##*/}
      name=${name%-*}
      [ "$name" = base ] || printf '%s\n' "$name"
    done
    for dir in "$BIN_DIR"/*/; do
      [ -d "$dir" ] || continue
      name=${dir%/}
      name=${name##*/}
      [ "$name" = base ] || printf '%s\n' "$name"
    done
  } | sort -u
}

resolve_profile() {
  [ -n "$PROFILE" ] && return 0
  if [ -t 0 ]; then
    available=$(list_profiles | tr '\n' ' ' | sed 's/ $//')
    printf 'Profile [%s] (%s): ' "$DEFAULT_PROFILE" "$available" >&2
    read -r answer || answer=""
    PROFILE=${answer:-$DEFAULT_PROFILE}
  else
    die "no profile set — use --profile <name> (available: $(list_profiles | tr '\n' ' ' | sed 's/ $//'))"
  fi
  case "$PROFILE" in
  "" | */* | .*) die "invalid profile name: $PROFILE" ;;
  esac
}

# --- packages ---------------------------------------------------------------

ensure_paru() {
  command -v paru >/dev/null 2>&1 && return 0
  note "paru not found — bootstrapping it from the AUR"
  run_sudo pacman -S --needed --noconfirm base-devel git
  build_dir=$(mktemp -d)
  run git clone "$PARU_AUR_URL" "$build_dir/paru"
  if [ "$DRY_RUN" = 1 ]; then
    note "would run: makepkg -si (in $build_dir/paru)"
  else
    (
      cd "$build_dir/paru"
      makepkg -si --noconfirm
    )
  fi
  rm -rf "$build_dir"
}

install_arch() {
  packages=$(collect_packages pacman)
  if [ -n "$packages" ]; then
    note "installing pacman packages ($(printf '%s\n' "$packages" | count_lines))"
    # shellcheck disable=SC2086
    run_sudo pacman -S --needed --noconfirm $packages
  fi

  aur_packages=$(collect_packages aur)
  if [ -n "$aur_packages" ]; then
    ensure_paru
    note "installing AUR packages ($(printf '%s\n' "$aur_packages" | count_lines))"
    # shellcheck disable=SC2086
    run paru -S --needed --noconfirm $aur_packages
  fi
}

install_macos() {
  command -v brew >/dev/null 2>&1 || die "Homebrew is required on macOS — install it first:
  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
  for file in "$PACKAGES_DIR/base-macos" "$PACKAGES_DIR/$PROFILE-macos"; do
    [ -f "$file" ] || continue
    note "brew bundle --file ${file#"$REPO_DIR"/}"
    run brew bundle --file "$file" --no-lock
  done
}

install_apt() {
  packages=$(collect_packages apt)
  [ -n "$packages" ] || return 0
  note "installing apt packages ($(printf '%s\n' "$packages" | count_lines))"
  run_sudo apt-get update -qq
  # shellcheck disable=SC2086
  run_sudo apt-get install -y $packages
}

install_packages() {
  case "$OS" in
  arch) install_arch ;;
  macos) install_macos ;;
  apt) install_apt ;;
  esac
  ensure_fonts
}

# --- fonts ------------------------------------------------------------------

# Terminal configs use this family. pacman and brew install it as a package; apt has none,
# so a pinned Nerd Fonts release goes into ~/.local/share/fonts.
FONT_FAMILY="JetBrainsMono Nerd Font"
FONT_RELEASE="https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/JetBrainsMono.tar.xz"

font_installed() {
  if command -v fc-list >/dev/null 2>&1; then
    fc-list | grep -qi "$FONT_FAMILY"
  else
    find "$HOME/Library/Fonts" /Library/Fonts -iname '*JetBrainsMonoNerd*' 2>/dev/null | grep -q .
  fi
}

ensure_fonts() {
  font_installed && return 0
  [ "$OS" = apt ] || {
    warn "$FONT_FAMILY is not installed — check the font entry in packages/"
    return 0
  }
  dest="$HOME/.local/share/fonts/JetBrainsMono"
  note "installing $FONT_FAMILY to ${dest#"$HOME"/}"
  run mkdir -p "$dest"
  if [ "$DRY_RUN" = 1 ]; then
    note "would run: curl -fsSL $FONT_RELEASE | tar -xJ -C $dest"
    return 0
  fi
  curl -fsSL "$FONT_RELEASE" | tar -xJ -C "$dest" || die "font download failed: $FONT_RELEASE"
  run fc-cache -f "$dest"
}

# --- files ------------------------------------------------------------------

# One "source<TAB>target" line per managed file. dotconfigs/ mirrors $HOME: every file git
# knows there (tracked, or new and not ignored), except the repo's own .gitignore files.
# bin/base + bin/<profile> go to ~/.local/bin.
managed_files() {
  git -C "$DOTCONFIGS_DIR" ls-files --cached --others --exclude-standard | sort -u |
    grep -v -e '^\.gitignore$' -e '/\.gitignore$' |
    while IFS= read -r rel; do
      [ -f "$DOTCONFIGS_DIR/$rel" ] && printf '%s\t%s\n' "$DOTCONFIGS_DIR/$rel" "$HOME/$rel"
    done
  for dir in "$BIN_DIR/base" "$BIN_DIR/$PROFILE"; do
    [ -d "$dir" ] || continue
    for script in "$dir"/*; do
      [ -f "$script" ] && printf '%s\t%s\n' "$script" "$BIN_TARGET/${script##*/}"
    done
  done
  return 0
}

# true when PATH is a symlink into this repo (left by the old stow setup)
is_repo_link() {
  [ -L "$1" ] || return 1
  case "$(readlink -f "$1" 2>/dev/null)" in
  "$REPO_DIR"/*) return 0 ;;
  esac
  return 1
}

# Remove symlinks into this repo on the way to any managed file, whole directories
# included, so copies land in $HOME and not back in the repo. Other links are left alone.
remove_repo_links() {
  managed_files | cut -f2 | while IFS= read -r path; do
    while [ "$path" != "$HOME" ] && [ "$path" != / ]; do
      printf '%s\n' "$path"
      path=$(dirname "$path")
    done
  done | sort -u | while IFS= read -r path; do
    is_repo_link "$path" || continue
    note "replacing the link ${path#"$HOME"/} with a copy"
    run rm "$path"
  done
}

# true when FILE is an unmodified older copy of REL (a path in this repo): its content equals
# some earlier committed version, so it only needs updating. A file with local edits matches
# none, and so does one the repo has never tracked.
is_stale_copy() {
  stale_hash=$(git -C "$REPO_DIR" hash-object -- "$1" 2>/dev/null) || return 1
  git -C "$REPO_DIR" log --format=%H -- "$2" 2>/dev/null |
    while IFS= read -r stale_commit; do
      git -C "$REPO_DIR" rev-parse -q --verify "$stale_commit:$2" 2>/dev/null
    done | grep -qx "$stale_hash"
}

# Copy repo files into $HOME. Missing files are added and unedited older copies updated; files
# edited locally are kept and reported, or with --force backed up and replaced.
copy_files() {
  remove_repo_links
  managed_files | while IFS=$TAB read -r src dst; do
    rel=${dst#"$HOME"/}
    if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
      run mkdir -p "$(dirname "$dst")"
      run cp -p "$src" "$dst"
      note "added $rel"
    elif cmp -s "$src" "$dst"; then
      continue
    elif is_stale_copy "$dst" "${src#"$REPO_DIR"/}"; then
      run cp -p "$src" "$dst"
      note "updated $rel: the repo has a newer version"
    elif [ "$FORCE" = 1 ]; then
      back_up "$dst"
      run cp -p "$src" "$dst"
      note "replaced $rel"
    else
      warn "kept $rel: it differs from the repo (setup diff, then setup save or --force)"
    fi
  done
}

# Print every managed file that is missing here or differs from the repo.
run_diff() {
  resolve_profile
  managed_files | while IFS=$TAB read -r src dst; do
    if [ ! -e "$dst" ]; then
      printf 'missing here: %s\n' "${dst#"$HOME"/}"
    elif cmp -s "$src" "$dst"; then
      continue
    elif is_stale_copy "$dst" "${src#"$REPO_DIR"/}"; then
      printf 'older copy (setup updates it): %s\n' "${dst#"$HOME"/}"
    else
      git --no-pager diff --no-index -- "$src" "$dst" || true
    fi
  done
}

# Copy this machine's edits back into the repo; review with git diff, then commit.
run_save() {
  resolve_profile
  managed_files | while IFS=$TAB read -r src dst; do
    [ -f "$dst" ] || continue
    is_repo_link "$dst" && continue
    cmp -s "$src" "$dst" && continue
    is_stale_copy "$dst" "${src#"$REPO_DIR"/}" && continue
    run cp "$dst" "$src"
    note "saved ${dst#"$HOME"/}"
  done
  printf '\nnext:     git -C "%s" diff, then commit what should be shared\n' "$REPO_DIR"
}

clone_alacritty_themes() {
  themes_dir="$XDG_CONFIG_HOME/alacritty/themes"
  [ -d "$DOTCONFIGS_DIR/.config/alacritty" ] || return 0
  [ -d "$themes_dir" ] && return 0
  # an older setup cloned them inside the repo; reuse that clone
  if [ -d "$DOTCONFIGS_DIR/.config/alacritty/themes" ]; then
    note "copying alacritty themes from the repo's old clone"
    run cp -R "$DOTCONFIGS_DIR/.config/alacritty/themes" "$themes_dir"
    return 0
  fi
  note "cloning alacritty themes"
  run git clone "$ALACRITTY_THEMES_REPO" "$themes_dir"
}

# drop any previous or legacy dotfiles block from an rc file
strip_rc_block() {
  awk '
    /^# dotfiles$/ { skip = 1; next }
    /^# Source dotfiles$/ { skip = 1; next }
    skip == 1 { if ($0 ~ /init\.sh/) skip = 0; next }
    { print }
  ' "$1" >"$2"
}

# rewrite one shell rc file: drop any previous/legacy dotfiles block, append
# the current one. Unchanged files are left alone.
update_rc_file() {
  rc_file=$1
  if [ ! -f "$rc_file" ]; then
    if [ "$DRY_RUN" = 1 ]; then
      note "would create $rc_file with the dotfiles block"
      return 0
    fi
    touch "$rc_file"
    note "created $rc_file"
  fi

  filtered=$(mktemp)
  updated=$(mktemp)
  strip_rc_block "$rc_file" "$filtered"
  {
    cat "$filtered"
    printf '%s\n' "# dotfiles"
    printf 'export DOTFILES_DIR="%s"\n' "$REPO_DIR"
    printf '%s\n' '[ -r "$DOTFILES_DIR/init.sh" ] && . "$DOTFILES_DIR/init.sh"'
  } >"$updated"

  if cmp -s "$rc_file" "$updated"; then
    rm -f "$filtered" "$updated"
    return 0
  fi
  if [ "$DRY_RUN" = 1 ]; then
    note "would update the dotfiles block in $rc_file (DOTFILES_DIR=$REPO_DIR)"
  else
    cat "$updated" >"$rc_file"
    note "updated $rc_file (DOTFILES_DIR=$REPO_DIR)"
  fi
  rm -f "$filtered" "$updated"
}

install_files() {
  require_command git
  note "copying dotconfigs/ and bin scripts"
  copy_files
  clone_alacritty_themes
  update_rc_file "$HOME/.zshrc"
  [ -f "$HOME/.bashrc" ] && update_rc_file "$HOME/.bashrc"
  return 0
}

# --- setup (plain run) ------------------------------------------------------

verify_and_report() {
  missing=""
  for tool in git zsh; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
  done
  printf '\n'
  printf 'profile:  %s\n' "$PROFILE"
  printf 'os:       %s\n' "$OS"
  printf 'stage:    %s\n' "$STAGE"
  if [ -n "$missing" ]; then
    warn "missing:${missing} — install and re-run"
  else
    printf 'checked:  git · zsh\n'
  fi
  if font_installed; then
    printf 'font:     %s\n' "$FONT_FAMILY"
  else
    warn "font missing: $FONT_FAMILY — run: setup --packages"
  fi
  printf 'next:     exec zsh\n'
  printf 'files:    setup diff · setup save (local edits → repo, then commit)\n'
}

run_setup() {
  resolve_profile
  OS=$(detect_os)
  case "$OS" in
  arch | macos | apt) ;;
  *) die "unsupported OS: $OS (supported: arch · macos · debian/ubuntu)" ;;
  esac

  note "dotfiles setup — profile $PROFILE · os $OS · stage $STAGE"

  run mkdir -p "$XDG_CONFIG_HOME" "$BIN_TARGET"

  if [ "$STAGE" = all ] || [ "$STAGE" = packages ]; then
    install_packages
  fi

  if [ "$STAGE" = all ] || [ "$STAGE" = files ]; then
    install_files
  fi

  verify_and_report
}

# --- uninstall --------------------------------------------------------------

# Copies belong to the machine and stay. Uninstall removes what still points into the
# repo (links from the old stow setup) and the rc block.
run_uninstall() {
  remove_repo_links
  for link in "$BIN_TARGET"/* "$BIN_TARGET"/.[!.]*; do
    is_repo_link "$link" || continue
    note "removing bin link ${link#"$HOME"/}"
    run rm -f "$link"
  done

  for rc_file in "$HOME/.zshrc" "$HOME/.bashrc"; do
    [ -f "$rc_file" ] || continue
    filtered=$(mktemp)
    strip_rc_block "$rc_file" "$filtered"
    if cmp -s "$rc_file" "$filtered"; then
      rm -f "$filtered"
      continue
    fi
    if [ "$DRY_RUN" = 1 ]; then
      note "would remove the dotfiles block from $rc_file"
      rm -f "$filtered"
    else
      cat "$filtered" >"$rc_file"
      rm -f "$filtered"
      note "removed the dotfiles block from $rc_file"
    fi
  done

  printf '\n'
  printf 'uninstalled: repo links removed · rc block stripped · copied files kept\n'
}

# --- desktop defaults (KDE) -------------------------------------------------

desktop_entry_exists() {
  entry=$1
  old_ifs=$IFS
  IFS=:
  for dir in $APP_DIRS; do
    if [ -f "$dir/$entry" ]; then
      IFS=$old_ifs
      return 0
    fi
  done
  IFS=$old_ifs
  return 1
}

set_mime_default() {
  entry=$1
  shift
  desktop_entry_exists "$entry" || return 0
  for mime in "$@"; do
    run xdg-mime default "$entry" "$mime" || warn "failed to set $mime → $entry"
  done
}

is_kde_desktop() {
  case "${XDG_CURRENT_DESKTOP:-}:${DESKTOP_SESSION:-}" in
  *KDE* | *kde* | *Plasma* | *plasma*) return 0 ;;
  *) return 1 ;;
  esac
}

# terminal choice + launch shortcuts via kwriteconfig6
apply_kde_shortcuts() {
  command -v kwriteconfig6 >/dev/null 2>&1 || return 0
  desktop_entry_exists Alacritty.desktop || return 0

  run kwriteconfig6 --file kdeglobals --group General --key TerminalApplication --notify alacritty
  run kwriteconfig6 --file kdeglobals --group General --key TerminalService --notify Alacritty.desktop
  run kwriteconfig6 --file kglobalshortcutsrc --group services --group Alacritty.desktop --key _launch --notify "Ctrl+Alt+T"

  if desktop_entry_exists com.mitchellh.ghostty.desktop; then
    run kwriteconfig6 --file kglobalshortcutsrc --group services --group com.mitchellh.ghostty.desktop --key _launch --notify ""
  fi
  if desktop_entry_exists org.kde.konsole.desktop; then
    run kwriteconfig6 --file kglobalshortcutsrc --group services --group org.kde.konsole.desktop --key _launch --notify none
  fi
}

# default application per MIME type (entries missing on this machine are skipped)
apply_mime_defaults() {
  command -v xdg-mime >/dev/null 2>&1 || return 0

  set_mime_default firefox.desktop \
    x-scheme-handler/http x-scheme-handler/https x-scheme-handler/mailto \
    text/html application/xhtml+xml application/xml text/xml application/pdf

  set_mime_default code.desktop \
    text/plain application/json application/x-shellscript \
    text/x-c text/x-c++src text/x-chdr text/x-c++hdr \
    text/x-java text/x-python text/x-script.python text/x-lua text/x-rust text/markdown

  set_mime_default org.kde.gwenview.desktop \
    image/avif image/gif image/jpeg image/png image/svg+xml image/webp

  set_mime_default org.kde.haruna.desktop \
    video/mp4 video/x-matroska video/mpeg video/ogg video/quicktime video/webm

  set_mime_default mpv.desktop \
    audio/aac audio/flac audio/mp4 audio/mpeg audio/ogg audio/vnd.wave audio/webm

  set_mime_default org.kde.dolphin.desktop inode/directory

  set_mime_default org.kde.ark.desktop \
    application/gzip application/vnd.rar application/x-7z-compressed \
    application/x-bzip2 application/x-compressed-tar application/x-tar \
    application/x-xz application/zip

  if desktop_entry_exists vesktop.desktop; then
    set_mime_default vesktop.desktop x-scheme-handler/discord
  fi
}

# copy the current KWin screen layout to the login greeter (plasmalogin/sddm)
apply_login_display_config() {
  is_kde_desktop || return 0

  output_config="$XDG_CONFIG_HOME/kwinoutputconfig.json"
  [ -r "$output_config" ] || return 0

  greeter_user=""
  if getent passwd plasmalogin >/dev/null 2>&1; then
    greeter_user=plasmalogin
  elif getent passwd sddm >/dev/null 2>&1; then
    greeter_user=sddm
  fi
  [ -n "$greeter_user" ] || return 0

  greeter_home=$(getent passwd "$greeter_user" | cut -d: -f6)
  [ -n "$greeter_home" ] || return 0

  note "applying the KDE display layout to the $greeter_user login screen"
  run_sudo install -D -m 600 -o "$greeter_user" -g "$greeter_user" \
    "$output_config" "$greeter_home/.config/kwinoutputconfig.json"
}

# --- configure (opt-in) -----------------------------------------------------

is_cachyos() {
  [ -r /etc/os-release ] && (
    . /etc/os-release
    [ "${ID:-}" = "cachyos" ]
  )
}

apply_git_defaults() {
  command -v git >/dev/null 2>&1 || return 0

  run git config --global init.defaultBranch main
  run git config --global pull.rebase true
  run git config --global fetch.prune true
  run git config --global core.editor "${EDITOR:-nvim}"

  if command -v delta >/dev/null 2>&1; then
    run git config --global core.pager delta
    run git config --global interactive.diffFilter "delta --color-only"
    run git config --global delta.side-by-side true
    run git config --global delta.line-numbers true
    run git config --global delta.navigate true
  elif command -v difft >/dev/null 2>&1; then
    run git config --global diff.external difft
  fi

  if command -v difft >/dev/null 2>&1; then
    run git config --global alias.dft "-c diff.external=difft diff"
    run git config --global alias.dshow "-c diff.external=difft show --ext-diff"
    run git config --global alias.dlog "-c diff.external=difft log -p --ext-diff"
    run git config --global alias.dst "-c diff.external=difft stash show --ext-diff -p"
  fi
}

apply_zsh_default() {
  command -v zsh >/dev/null 2>&1 || return 0
  zsh_path=$(command -v zsh)
  [ "${SHELL:-}" = "$zsh_path" ] && return 0
  note "setting the default shell to zsh"
  run chsh -s "$zsh_path" || warn "could not change the shell — run: chsh -s \"$zsh_path\""
}

# CachyOS ships a zsh config that overrides the prompt; disable that one line
apply_cachyos_zsh_fixup() {
  rc_file=$HOME/.zshrc
  [ -f "$rc_file" ] || return 0
  is_cachyos || return 0
  grep -Fqx "$CACHYOS_ZSH_LINE" "$rc_file" || return 0
  run sh -c 'sed "s|^$2\$|# &|" "$1" >"$1.tmp" && mv "$1.tmp" "$1"' sh "$rc_file" "$CACHYOS_ZSH_LINE"
  note "disabled the CachyOS zsh config in $rc_file"
}

run_configure() {
  note "dotfiles configure — desktop + git defaults (opt-in)"
  run mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$BIN_TARGET" "$PROJECTS_DIR"
  ensure_line_in_file "$HOME/.zshrc" 'export PATH="$HOME/.local/bin:$PATH"'
  apply_cachyos_zsh_fixup
  apply_zsh_default
  apply_git_defaults
  if is_kde_desktop; then
    apply_kde_shortcuts
    apply_mime_defaults
    apply_login_display_config
  fi
  printf '\nconfigured: xdg dirs · ~/projects · zsh shell · git defaults · desktop defaults (KDE only)\n'
}

# --- entry ------------------------------------------------------------------

parse_args() {
  case "${1:-}" in
  diff | save | uninstall | configure)
    COMMAND=$1
    shift
    ;;
  esac

  while [ $# -gt 0 ]; do
    case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -n | --dry-run)
      DRY_RUN=1
      shift
      ;;
    -p | --profile)
      [ -n "${2:-}" ] || die "option $1 requires an argument"
      PROFILE=$2
      shift 2
      ;;
    --profile=*)
      PROFILE=${1#--profile=}
      shift
      ;;
    --packages)
      [ "$STAGE" = files ] && die "--packages and --files are mutually exclusive"
      STAGE=packages
      shift
      ;;
    --files | --links)
      [ "$STAGE" = packages ] && die "--packages and --files are mutually exclusive"
      STAGE=files
      shift
      ;;
    -f | --force)
      FORCE=1
      shift
      ;;
    --)
      shift
      [ $# -eq 0 ] || die "unexpected argument: $1"
      ;;
    -*)
      die "unknown option: $1 (try --help)"
      ;;
    *)
      die "unexpected argument: $1 (try --help)"
      ;;
    esac
  done

  [ "$COMMAND" = setup ] || [ "$STAGE" = all ] || die "stage switches only apply to a plain setup run"
}

main() {
  parse_args "$@"
  case "$COMMAND" in
  setup) run_setup ;;
  diff) run_diff ;;
  save) run_save ;;
  uninstall) run_uninstall ;;
  configure) run_configure ;;
  esac
}

main "$@"
