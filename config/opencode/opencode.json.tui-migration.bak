{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "autoupdate": true,
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-lmstudio@latest"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local-talos)",
      "options": {
        "baseURL": "http://talos.home.arpa:1234/v1"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "node@lts",
        "--",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": ""
      },
      "enabled": true
    },
    "ddg-search": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "uv",
        "--",
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "deepwiki": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "node@lts",
        "--",
        "npx",
        "-y",
        "mcp-deepwiki@latest"
      ]
    },
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwright": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "node@lts",
        "--",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "zai-image": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "node@lts",
        "--",
        "node",
        "{env:HOME}/.config/opencode/scripts/zai-mcp-launcher.mjs"
      ],
      "environment": {
        "Z_AI_MODE": "ZAI"
      },
      "enabled": true
    }
  },
  "keybinds": {
    "app_exit": "ctrl+c,<leader>q"
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "agent": {
    "plan": {
      "temperature": 0.1
    },
    "build": {
      "temperature": 0.6
    }
  },
  "lsp": {},
  "permission": {}
}
